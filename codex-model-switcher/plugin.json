{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-model-switcher",
  "version": "0.2.1",
  "description": "选择供应商和模型，新建 Codex 会话或修改已有会话的模型。",
  "author": {
    "name": "zeng ge",
    "email": "675324311@qq.com"
  },
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "mcpServers": "./.mcp.json",
      "skills": "./skills/",
      "interface": {
        "displayName": "供应商与模型",
        "shortDescription": "新建会话或修改已有会话模型",
        "longDescription": "通过本机面板选择供应商、模型和项目新建会话，或修改同一供应商已有会话的模型与思考强度。默认 custom / qwen3.8-27b / xhigh。保留原会话上下文，不发送消息，不修改定时任务或全局模型目录；不支持跨供应商修改已有会话。密钥只在本机后端使用。",
        "developerName": "zeng ge",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg",
        "defaultPrompt": "打开供应商与模型面板，选择供应商和模型新建会话"
      }
    }
  },
  "repository": "https://github.com/TheLastMagician/codex-connect",
  "homepage": "https://github.com/TheLastMagician/codex-connect/tree/main/codex-model-switcher"
}
