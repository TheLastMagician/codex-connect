{
  "mcpServers": {
    "feishu_desktop": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/dist/server.cjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env_vars": ["CODEX_APP_TOOLS_PIPE_PATH", "CODEX_THREAD_ID", "CODEX_SESSION_ID", "USERPROFILE", "LOCALAPPDATA", "PATH"],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 60
    }
  }
}
